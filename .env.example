# ==========================================
# CloudDeploy - Environment Configuration
# ==========================================

# Port Configuration
PORT=5000
NODE_ENV=production

# Database Credentials (PostgreSQL)
POSTGRES_USER=clouddeploy
POSTGRES_PASSWORD=clouddeploy_secret
POSTGRES_DB=clouddeploy_db
DATABASE_URL=postgresql://clouddeploy:clouddeploy_secret@localhost:5432/clouddeploy_db?schema=public

# Security & Authentication
JWT_SECRET=clouddeploy_super_secure_jwt_secret_key_2026_production_style
JWT_EXPIRES_IN=24h
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://localhost:80

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# AWS & Cloud Orchestration
AWS_REGION=us-east-1
AWS_S3_BUCKET=clouddeploy-artifacts-prod-2026
AWS_ECR_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com
INFRASTRUCTURE_MODE=simulated # simulated | aws
KUBERNETES_MODE=simulated     # simulated | cluster
